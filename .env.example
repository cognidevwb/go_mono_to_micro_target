# Copy to `.env` and fill in. `.env` is git-ignored; this file is the documentation.

# ── One database per service ──
CATALOG_DATABASE_URL=postgres://catalog_app:REPLACE_ME@localhost:5432/catalogdb?sslmode=require
CUSTOMERS_DATABASE_URL=postgres://customers_app:REPLACE_ME@localhost:5432/customersdb?sslmode=require
INVENTORY_DATABASE_URL=postgres://inventory_app:REPLACE_ME@localhost:5432/inventorydb?sslmode=require
PAYMENTS_DATABASE_URL=postgres://payments_app:REPLACE_ME@localhost:5432/paymentsdb?sslmode=require
ORDERS_DATABASE_URL=postgres://orders_app:REPLACE_ME@localhost:5432/ordersdb?sslmode=require

# ── Event backbone (nats) ──
BROKER_URL=nats://localhost:4222

# ── Service-to-service ──
CATALOG_SERVICE_URL=http://catalog-service:8080
CUSTOMERS_SERVICE_URL=http://customers-service:8080
INVENTORY_SERVICE_URL=http://inventory-service:8080
PAYMENTS_SERVICE_URL=http://payments-service:8080
ORDERS_SERVICE_URL=http://orders-service:8080
# Shared secret a service presents when it calls another (pkg/httpx). Set it in
# every deployed environment; unset, the gateway alone keeps outsiders out.
INTERNAL_TOKEN=REPLACE_ME

# ── Settings the monolith read from its environment ──
PAYMENTS_URL=REPLACE_ME

# ── Identity (jwt-keycloak) — validated at the gateway, re-validated per service ──
AUTH_ISSUER=http://localhost:8081/realms/REPLACE_ME
AUTH_AUDIENCE=REPLACE_ME

# ── Telemetry (otel-lgtm) ──
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Strangler cutover: where the gateway sends what no service owns yet ──
LEGACY_UPSTREAM=http://localhost:8080
