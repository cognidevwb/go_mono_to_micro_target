    "services/orders",
    "services/catalog",
    "services/customers",
    "services/inventory",
    "services/payments"
  ],
  "kept_monolithic": [],
  "modify": [
    {
      "path": "internal/orders/service.go",
      "purpose": "replace the cross-service unit of work in PlaceOrder with the CreateOrder saga (outbox + compensations) — writes in inventory, orders, payments"
    }
  ],
  "order": [
    "orders-service",
    "catalog-service",
    "customers-service",
    "inventory-service",
    "payments-service"
  ],
  "sagas": [
    {
      "name": "CreateOrder",
      "orchestrator": "orders-service",
      "participants": [
        "inventory",
        "orders",
        "payments"
      ],
      "pivot": "orders",
      "steps": [
        {
          "action": "s.inventory.Reserve",
          "compensation": "compensable (Jev p=0.88): undo `s.inventory.Reserve` in inventory",
          "context": "inventory"
        },
        {
          "action": "s.payments.Charge",
          "compensation": "needs decision — Jev could not tell whether this step can be undone",
          "context": "payments"
        }
      ]
    }
  ],
